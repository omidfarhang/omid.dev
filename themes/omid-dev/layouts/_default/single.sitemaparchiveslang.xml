{{ partial "sitemap/xml-header.html" . }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
  xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{{- with site.GetPage "section" "archives" -}}
  {{- if and (eq .Lang site.Language.Lang) (not .Params.robotsNoIndex) -}}
    {{- partial "sitemap/url-entry.html" . -}}
  {{- end -}}
  {{- range .Sections -}}
    {{- if and (eq .Lang site.Language.Lang) (not .Params.robotsNoIndex) -}}
      {{- partial "sitemap/url-entry.html" . -}}
    {{- end -}}
    {{- range .Sections -}}
      {{- if and (eq .Lang site.Language.Lang) (not .Params.robotsNoIndex) -}}
        {{- partial "sitemap/url-entry.html" . -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
</urlset>
